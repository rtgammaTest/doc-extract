# Copy to .env and fill in. Every value has a local-only default, so the
# pipeline, the tests and the eval all run with none of this set.

# --- Google Cloud ---------------------------------------------------------
PROJECT=
REGION=us-east4
DATASET=doc_extract
RAW_BUCKET=

# --- Backends -------------------------------------------------------------
# fake       = deterministic regex baseline, no network, no cost
# vertex     = Gemini via Vertex AI, using the service account's IAM
# gemini-api = Gemini via generativelanguage.googleapis.com, using an API key
#              from https://aistudio.google.com/apikey -- a separate entitlement
#              path from Vertex, and the way through when a project can reach
#              Vertex the service but not its publisher models.
MODEL_BACKEND=fake

# Only read when MODEL_BACKEND=gemini-api. Never commit this.
GEMINI_API_KEY=

# jsonl = local append-only files under OUT_DIR
# bigquery = the real store
STORE_BACKEND=jsonl

# --- Versioning -----------------------------------------------------------
# Bump this when extraction behaviour changes. It lands on every row, and it
# is how you tell a re-run apart from the run it replaced.
EXTRACTOR_VERSION=1.0.0
# Older models are retired for new accounts and the APIs report that as a
# plain 404 with no mention of deprecation -- check the model list before
# assuming a permissions problem:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
MODEL_ID=gemini-3.8-flash

# Where Gemini is called from. NOT the same as REGION: Gemini is served from
# a subset of regions, and us-east4 is not one of them. us-central1 is the
# safe default; "global" also works and is what the cost table was priced at.
VERTEX_LOCATION=us-central1
PROMPT_VERSION=v1

# --- Guardrails -----------------------------------------------------------
# The failure mode that costs real money is a retry loop sending whole
# documents. Keep this low and set a budget alert anyway.
MAX_RETRIES=2
TEMPERATURE=0.0
OUT_DIR=out
